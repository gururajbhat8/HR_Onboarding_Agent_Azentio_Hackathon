# ==============================================================================
# AZENTIO HR ONBOARDING AGENT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="Azentio HR Onboarding Agent"
APP_ENV=development
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8501

# ------------------------------------------------------------------------------
# 2. LLM INFERENCE (GROQ CLOUD / LLAMA 3)
# ------------------------------------------------------------------------------
# Obtain your free API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
FALLBACK_MODEL=llama-3.1-8b-instant

# ------------------------------------------------------------------------------
# 3. VECTOR DATABASE (PINECONE SERVERLESS)
# ------------------------------------------------------------------------------
# Obtain your free API key from: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=azentio-hr-policies
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# 4. AWS SERVICES (FREE TIER / $100 CREDIT)
# ------------------------------------------------------------------------------
# AWS IAM credentials for S3 Document Storage and Textract OCR
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=azentio-onboarding-documents
ENABLE_AWS_TEXTRACT=true

# ------------------------------------------------------------------------------
# 5. RELATIONAL DATABASE (POSTGRESQL / SQLITE FALLBACK)
# ------------------------------------------------------------------------------
# Use local SQLite for fast zero-config hackathon runs, or PostgreSQL for production:
# Production PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/azentio_hr
DATABASE_URL=sqlite+aiosqlite:///./azentio_onboarding.db

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & EVALUATION (OPTIONAL)
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=azentio-hr-onboarding

